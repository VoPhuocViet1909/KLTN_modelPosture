/* TỰ SINH từ design_tokens.json bởi build_theme.py – đừng sửa tay. */
* { font-family: "Be Vietnam Pro"; font-size: 14px; color: #1c2433; outline: none; }
QMainWindow, QDialog, QWidget#root { background: #f4f5f3; }
QToolTip { background: #ffffff; color: #1c2433; border: 1px solid #e1e4df; padding: 4px 8px; }

QFrame#panel { background: #ffffff; border: 1px solid #e1e4df; border-radius: 11px; }
QFrame#panel QLabel { background: transparent; }
QScrollArea, QScrollArea > QWidget > QWidget { background: #f4f5f3; border: none; }
QFrame#panel QLabel#preview { background: #eef0ec; border: 1px solid #e1e4df; border-radius: 6px; color: #5b6472; }

QLabel { background: transparent; }
QLabel#pageTitle { font-size: 24px; font-weight: 600; }
QLabel#sectionTitle { font-size: 16px; font-weight: 500; }
QLabel#note { font-size: 12px; color: #5b6472; }
QLabel#bigNumber { font-size: 48px; font-weight: 600; }
QLabel#stateText { font-size: 16px; font-weight: 500; color: #1c2433; }
QLabel#error { color: #d03b3b; font-size: 14px; }

QPushButton { background: #ffffff; border: 1px solid #d5d9d3; border-radius: 6px; padding: 8px 16px; min-height: 26px;
  font-weight: 500; }
QPushButton:hover { background: #e8eef8; }
QPushButton:focus { border: 2px solid #2a78d6; padding: 7px 15px; }
QPushButton:disabled { color: #5b6472; background: #eef0ec; }
QPushButton#primary { background: #256abf; color: #ffffff; border: 1px solid #256abf; }
QPushButton#primary:hover { background: #1c5cab; border-color: #1c5cab; }
QPushButton#primary:disabled { background: #86b6ef; border-color: #86b6ef; color: #ffffff; }
QPushButton#link { border: none; background: transparent; color: #256abf; padding: 4px 8px; }
QPushButton#link:hover { background: transparent; text-decoration: underline; }
QPushButton#link:focus { border: 2px solid #2a78d6; padding: 2px 6px; }

QLineEdit { background: #ffffff; border: 1px solid #d5d9d3; border-radius: 6px; padding: 8px 12px; min-height: 26px;
  selection-background-color: #cde2fb; selection-color: #1c2433; }
QLineEdit:focus { border: 2px solid #2a78d6; padding: 7px 11px; }
QLineEdit[invalid="true"] { border-color: #d03b3b; }
QComboBox { background: #ffffff; border: 1px solid #d5d9d3; border-radius: 6px; min-height: 30px; padding: 6px 12px; }
QComboBox:focus { border: 2px solid #2a78d6; padding: 5px 11px; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #e8eef8; selection-color: #1c2433; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #d5d9d3; border-radius: 4px; background: #ffffff; }
QCheckBox::indicator:checked { background: #256abf; border-color: #256abf; image: url("@ICONS@/check-white.svg"); }
QCheckBox::indicator:focus { border: 2px solid #2a78d6; }

QMenu { background: #ffffff; border: 1px solid #e1e4df; padding: 4px; }
QMenu::item { padding: 8px 24px; border-radius: 4px; }
QMenu::item:selected { background: #e8eef8; color: #1c2433; }
QMenu::separator { height: 1px; background: #e1e4df; margin: 4px 8px; }

QFrame#banner { background: #ffffff; border: 1px solid #e1e4df; border-radius: 6px; }
QFrame#banner QLabel { background: transparent; }
QDialog#alertDialog { background: #ffffff; }
