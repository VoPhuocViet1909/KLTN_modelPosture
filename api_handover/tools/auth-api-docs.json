{"openapi":"3.1.0","info":{"title":"Auth service API","description":"Login, token refresh, the public keys for verifying access tokens, the caller's own profile and account management. Contract: api_handover/openapi.yaml v1.1 (login, refresh and keys only).","version":"v1"},"servers":[{"url":"/"}],"tags":[{"name":"auth","description":"Token issuing and the caller's own session. Login, refresh and the key set need no access token."},{"name":"users","description":"Account management. SYS_ADMIN sees every organization; ORG_ADMIN only their own, and another organization's users are reported as not found."}],"paths":{"/api/v1/users":{"get":{"tags":["users"],"summary":"List users","description":"Permission: USER_READ. Oldest first. ORG_ADMIN gets only their organization (403 if they have none).","operationId":"list","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0,"minimum":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20,"maximum":100,"minimum":1}}],"responses":{"200":{"description":"A page of users","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserPage"}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/Forbidden"}},"security":[{"bearerAuth":[]}]},"post":{"tags":["users"],"summary":"Create a user","description":"Permission: USER_CREATE. An ORG_ADMIN always creates inside their own organization (the orgId sent is ignored) and cannot create a SYS_ADMIN.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAccount"}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}},"security":[{"bearerAuth":[]}]}},"/api/v1/auth/refresh":{"post":{"tags":["auth"],"summary":"Exchange a refresh token for a new token pair","description":"The refresh token is rotated: the one sent is invalid afterwards.","operationId":"refresh","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"200":{"description":"New token pair","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshResponse"}}}},"400":{"description":"VALIDATION_FAILED (see errors[]) or MALFORMED_REQUEST","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"AUTH_INVALID_REFRESH_TOKEN: unknown, expired or already used","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"INTERNAL_ERROR","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[]}},"/api/v1/auth/logout":{"post":{"tags":["auth"],"summary":"Sign out: revoke a refresh token","description":"Permission: SESSION_LOGOUT (every role). Revokes the token only if it belongs to the caller. Always 204, even if the token is unknown, used or someone else's. The access token stays valid until it expires.","operationId":"logout","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LogoutRequest"}}},"required":true},"responses":{"204":{"description":"Done"},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthenticated"}},"security":[{"bearerAuth":[]}]}},"/api/v1/auth/login":{"post":{"tags":["auth"],"summary":"Sign in with email and password","description":"Returns an access token (RS256 JWT) and a single-use refresh token.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Signed in","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"VALIDATION_FAILED (see errors[]) or MALFORMED_REQUEST","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"AUTH_INVALID_CREDENTIALS: unknown email, wrong password or disabled account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"INTERNAL_ERROR","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[]}},"/api/v1/users/{id}/status":{"patch":{"tags":["users"],"summary":"Lock or unlock a user","description":"Permission: USER_UPDATE_STATUS. Not for yourself; an ORG_ADMIN cannot touch a SYS_ADMIN. Locking revokes the user's refresh tokens; their current access token keeps working until it expires (15 minutes by default).","operationId":"changeStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeStatusRequest"}}},"required":true},"responses":{"200":{"description":"Updated user","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAccount"}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}},"security":[{"bearerAuth":[]}]}},"/api/v1/users/{id}/role":{"patch":{"tags":["users"],"summary":"Change a user's role","description":"Permission: USER_ASSIGN_ROLE. Not for yourself; an ORG_ADMIN cannot grant SYS_ADMIN or touch a SYS_ADMIN. A real change revokes the user's refresh tokens; their current access token keeps working until it expires (15 minutes by default).","operationId":"changeRole","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeRoleRequest"}}},"required":true},"responses":{"200":{"description":"Updated user","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAccount"}}}},"400":{"$ref":"#/components/responses/ValidationFailed"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}},"security":[{"bearerAuth":[]}]}},"/api/v1/users/{id}":{"get":{"tags":["users"],"summary":"Get one user","description":"Permission: USER_READ.","operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The user","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAccount"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}},"security":[{"bearerAuth":[]}]}},"/api/v1/auth/me":{"get":{"tags":["auth"],"summary":"The signed-in user","description":"Permission: PROFILE_READ (every role). Reads the current database row, so role and status are up to date even though the access token may be older. A user who no longer exists or is locked gets 401 AUTH_IDENTITY_MISSING.","operationId":"me","responses":{"200":{"description":"The caller","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAccount"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"}},"security":[{"bearerAuth":[]}]}},"/api/v1/auth/.well-known/jwks.json":{"get":{"tags":["auth"],"summary":"Public keys for verifying access tokens (JWK Set)","operationId":"jwks","responses":{"200":{"description":"JWK Set, public key material only","content":{"application/json":{"schema":{"type":"object","example":{"keys":[{"kty":"RSA","use":"sig","alg":"RS256","kid":"key-1","n":"...","e":"AQAB"}]}}}}}},"security":[]}}},"components":{"schemas":{"CreateUserRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","description":"Login email, unique case-insensitively.","example":"new.user@example.com","maxLength":254,"minLength":0},"password":{"type":"string","description":"Initial password: 8 to 200 characters and at most 72 bytes in UTF-8 (the limit of BCrypt, which stores it).","example":"<password>","maxLength":200,"minLength":8},"name":{"type":"string","description":"Display name.","example":"Nguyen Van B","maxLength":200,"minLength":0},"role":{"type":"string","description":"ORG_ADMIN callers cannot grant SYS_ADMIN.","enum":["USER","ORG_ADMIN","SYS_ADMIN"],"example":"USER","pattern":"USER|ORG_ADMIN|SYS_ADMIN"},"orgId":{"type":["string","null"],"description":"Organization id (UUID) or null. Ignored for ORG_ADMIN callers, who always create inside their own organization.","example":"0b6d1a52-7f0e-4b0a-9a57-3c1c1f1b9e10","pattern":"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"}},"required":["email","password","role"]},"UserAccount":{"type":"object","description":"A user account. Never includes the password or its hash.","properties":{"id":{"type":"string","example":"7c9e6679-7425-40de-944b-e07fc1f90ae7"},"email":{"type":"string","example":"user@example.com"},"name":{"type":["string","null"],"description":"Display name; null when none.","example":"Nguyen Van A"},"role":{"type":"string","enum":["USER","ORG_ADMIN","SYS_ADMIN"],"example":"USER"},"orgId":{"type":["string","null"],"description":"Organization id, or null when the user belongs to none.","example":"0b6d1a52-7f0e-4b0a-9a57-3c1c1f1b9e10"},"enabled":{"type":"boolean","description":"False when the account is locked."}},"required":["email","enabled","id","role"]},"RefreshRequest":{"type":"object","properties":{"refreshToken":{"type":"string","description":"Refresh token returned by login or the previous refresh.","example":"<refresh-token>","maxLength":512,"minLength":0}},"required":["refreshToken"]},"RefreshResponse":{"type":"object","properties":{"accessToken":{"type":"string","description":"Short-lived RS256 JWT.","example":"<access-token>"},"refreshToken":{"type":"string","description":"Replacement refresh token; the one sent is now invalid.","example":"<refresh-token>"},"expiresIn":{"type":"integer","format":"int64","description":"Access token lifetime in seconds.","example":900}},"required":["accessToken","expiresIn","refreshToken"]},"ErrorResponse":{"type":"object","description":"Error body shared by every non-2xx response of this service.","properties":{"code":{"type":"string","description":"Stable code for programs. Used here: AUTH_INVALID_CREDENTIALS (401), AUTH_INVALID_REFRESH_TOKEN (401), VALIDATION_FAILED (400), MALFORMED_REQUEST (400), INTERNAL_ERROR (500); HTTP_<status> for other framework errors such as 405 or 415.","example":"AUTH_INVALID_CREDENTIALS"},"message":{"type":"string","description":"Text for display; do not branch on it.","example":"Invalid email or password."},"traceId":{"type":["string","null"],"description":"Trace id of the request, for finding it in logs; null when tracing has none.","example":"4bf92f3577b34da6a3ce929d0e0e4736"},"errors":{"type":"array","description":"Per-field problems; empty when the error is not about specific fields.","items":{"$ref":"#/components/schemas/FieldProblem"}}},"required":["code","errors","message"]},"FieldProblem":{"type":"object","description":"One invalid request field. The rejected value is never returned.","properties":{"field":{"type":"string","description":"Name of the invalid field.","example":"email"},"message":{"type":"string","description":"Why it is invalid.","example":"must be a well-formed email address"}},"required":["field","message"]},"LogoutRequest":{"type":"object","properties":{"refreshToken":{"type":"string","description":"Refresh token to revoke.","example":"<refresh-token>","maxLength":512,"minLength":0}},"required":["refreshToken"]},"LoginRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","description":"Account email; matched case-insensitively.","example":"user@example.com","maxLength":254,"minLength":0},"password":{"type":"string","description":"Account password.","example":"<password>","maxLength":200,"minLength":0},"deviceId":{"type":"string","description":"Client-chosen device identifier.","example":"dev_0123456789ab","maxLength":128,"minLength":0},"deviceName":{"type":"string","description":"Human-readable device name.","example":"Office laptop","maxLength":200,"minLength":0}},"required":["email","password"]},"LoginResponse":{"type":"object","properties":{"accessToken":{"type":"string","description":"Short-lived RS256 JWT. Send it as 'Authorization: Bearer <token>'.","example":"<access-token>"},"refreshToken":{"type":"string","description":"Single-use token for /refresh.","example":"<refresh-token>"},"expiresIn":{"type":"integer","format":"int64","description":"Access token lifetime in seconds.","example":900},"user":{"$ref":"#/components/schemas/UserView"}},"required":["accessToken","expiresIn","refreshToken","user"]},"UserView":{"type":"object","description":"The signed-in user.","properties":{"id":{"type":"string","description":"User id; equals the token's sub claim.","example":"7c9e6679-7425-40de-944b-e07fc1f90ae7"},"name":{"type":"string","description":"Display name; omitted when the user has none.","example":"Nguyen Van A"},"orgId":{"type":["string","null"],"description":"Organization id, or null when the user belongs to none.","example":"0b6d1a52-7f0e-4b0a-9a57-3c1c1f1b9e10"},"role":{"type":"string","description":"Role carried in the token.","enum":["USER","ORG_ADMIN","SYS_ADMIN"],"example":"USER"}},"required":["id","role"]},"ChangeStatusRequest":{"type":"object","properties":{"enabled":{"type":"boolean","description":"false locks the account and revokes its refresh tokens.","example":false}},"required":["enabled"]},"ChangeRoleRequest":{"type":"object","properties":{"role":{"type":"string","enum":["USER","ORG_ADMIN","SYS_ADMIN"],"example":"ORG_ADMIN","pattern":"USER|ORG_ADMIN|SYS_ADMIN"}},"required":["role"]},"UserPage":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/UserAccount"}},"page":{"type":"integer","format":"int32","description":"Zero-based page index.","example":0},"size":{"type":"integer","format":"int32","description":"Requested page size (at most 100).","example":20},"total":{"type":"integer","format":"int64","description":"Number of users the caller can see.","example":1}},"required":["items","page","size","total"]}},"responses":{"Unauthenticated":{"description":"AUTH_IDENTITY_MISSING from this service when the identity headers are absent; Gateway answers AUTH_TOKEN_MISSING, AUTH_TOKEN_INVALID or AUTH_TOKEN_EXPIRED for a bad token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"Forbidden":{"description":"AUTH_FORBIDDEN: the role lacks the permission, or a scope rule forbids it (own account, SYS_ADMIN target or role for an ORG_ADMIN, ORG_ADMIN without an organization).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"NotFound":{"description":"USER_NOT_FOUND, including users of another organization when the caller is an ORG_ADMIN.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"Conflict":{"description":"USER_EMAIL_TAKEN.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"ValidationFailed":{"description":"VALIDATION_FAILED (see errors[]) or MALFORMED_REQUEST.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}}}}